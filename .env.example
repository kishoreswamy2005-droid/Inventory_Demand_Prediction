# ------------------------------------------------------------------
# Copy to .env and adjust for your environment.
# NEVER commit a real .env file — it is excluded by .gitignore.
# ------------------------------------------------------------------

# --- Application ---
APP_NAME=Inventory Demand Prediction API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# REQUIRED in production: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Optional bootstrap admin (created at startup when provided).
# Password must be at least 8 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-now
# ADMIN_NAME=Administrator

# --- Database ---
# SQLite (default, fine for local development):
# DATABASE_URL=sqlite:///./inventory_demand.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://inventory:inventory@localhost:5432/inventory_demand

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Inventory business rules (days of cover) ---
DAYS_CRITICAL=1
DAYS_LOW=3
DAYS_OVERSTOCK=30

# --- Replenishment assumptions (illustrative) ---
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_REORDER_THRESHOLD_DAYS=3

# --- Prediction rate limiting (per IP) ---
PREDICTION_RATE_LIMIT=120
PREDICTION_RATE_WINDOW_SECONDS=60

# --- Dataset auto-seed on startup when tables are empty ---
AUTO_SEED_DATASET=true

# --- Model artifacts (defaults resolve to the project root) ---
MODEL_NAME=inventory_demand_random_forest
MODEL_VERSION=1.0.0
# MODEL_PATH=/absolute/path/to/inventory_demand_model.pkl
# DATASET_PATH=/absolute/path/to/retail_store_inventory.csv

# --- Frontend (frontend/.env, read at build time) ---
# VITE_API_URL=http://127.0.0.1:8000
